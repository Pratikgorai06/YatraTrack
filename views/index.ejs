<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>YatraTrack</title>

    <!-- Bootstrap & Leaflet -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"
      integrity="sha512-h9FcoyWjHcOcmEVkxOfTLnmZFWIH0iZhZT1H2TbOq55xssQGEJHEaIm+PgoUaZbRvQTNTluNOEfb1ZRy6D3BOw=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Custom Styles -->
    <style>
      body {
        font-family: "Segoe UI", sans-serif;
        background: #fdfdfd;
      }

      /* Navbar */
      .navbar {
        transition: all 0.3s ease;
      }
      .navbar-brand {
        font-size: 1.5rem;
        font-weight: bold;
        color: #0077b6 !important;
      }
      .nav-link {
        font-weight: 500;
        margin-left: 10px;
      }
      .nav-link:hover {
        color: #0077b6 !important;
      }

      /* Hero Section */
      .hero {
        background: linear-gradient(
            rgba(0, 119, 182, 0.8),
            rgba(0, 180, 216, 0.8)
          ),
          url("#") center/cover no-repeat;
        color: white;
        padding: 120px 20px;
        border-radius: 0 0 40px 40px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
      }
      .hero h1 {
        font-weight: bold;
        font-size: 3rem;
      }
      .hero .btn {
        padding: 12px 30px;
        border-radius: 30px;
        font-size: 1.1rem;
      }

      /* Features */
      .card {
        transition: transform 0.3s, box-shadow 0.3s;
        border-radius: 15px;
        border: none;
      }
      .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 8px 20px rgba(0, 119, 182, 0.3);
      }
      .card-title {
        font-size: 1.25rem;
        font-weight: bold;
        color: #0077b6;
      }

      /* Map Section */
      #map {
        height: 450px;
        width: 100%;
        margin-top: 20px;
        border-radius: 15px;
        border: 3px solid #0077b6;
      }

      /* Footer */
      footer {
        background: #0077b6;
        color: white;
        padding: 20px;
        text-align: center;
        border-radius: 30px 30px 0 0;
        margin-top: 50px;
      }
    </style>
  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar fixed-top navbar-expand-lg bg-white shadow-sm py-3">
      <div class="container">
        <a class="navbar-brand" href="/">YatraTrack</a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#navbarNavAltMarkup"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
          <div class="navbar-nav ms-auto">
            <a class="nav-link active" href="/">Home</a>
            <a class="nav-link" href="/auth">SignUp/Login</a>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero text-center">
      <div class="container">
        <h1>Welcome to YatraTrack</h1>
        <p class="lead mt-3">
          Smarter public transport with real-time tracking and planning 🚍
        </p>
        <a href="/auth" class="btn btn-light btn-lg mt-3 shadow">
          SignUp/Login
        </a>
      </div>
    </section>

    <!-- Features Section -->
    <main class="container my-5">
      <h2 class="text-center mb-5 fw-bold">✨ Our Key Features</h2>
      <div class="row g-4">
        <div class="col-md-4">
          <div class="card shadow-sm h-100 text-center p-4">
            <h5 class="card-title">🚌 Real-time Tracking</h5>
            <p class="card-text">
              Track live bus locations and arrival times on the go.
            </p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card shadow-sm h-100 text-center p-4">
            <h5 class="card-title">📶 Low-Bandwidth Friendly</h5>
            <p class="card-text">
              Optimized for towns and regions with poor internet access.
            </p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card shadow-sm h-100 text-center p-4">
            <h5 class="card-title">🌍 Multilingual Access</h5>
            <p class="card-text">
              Accessible to commuters of all ages in multiple languages.
            </p>
          </div>
        </div>
      </div>

      <div class="row g-4 mt-3">
        <div class="col-md-4">
          <div class="card shadow-sm h-100 text-center p-4">
            <h5 class="card-title">📱 Mobile & Web</h5>
            <p class="card-text">
              Available on both web and mobile for maximum accessibility.
            </p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card shadow-sm h-100 text-center p-4">
            <h5 class="card-title">🕒 Improved Planning</h5>
            <p class="card-text">
              Reduce wait times, overcrowding, and stress with smarter planning.
            </p>
          </div>
        </div>
        <div class="col-md-4">
          <div class="card shadow-sm h-100 text-center p-4">
            <h5 class="card-title">🏙️ Support for Authorities</h5>
            <p class="card-text">
              Helps local authorities manage public transport more efficiently.
            </p>
          </div>
        </div>
      </div>
    </main>

    <!-- Map Section -->
    <section class="container my-5">
      <h2 class="text-center mb-3 fw-bold">📍 Live Map</h2>
      <div id="map"></div>
    </section>

    <!-- Footer -->
    <footer>
      &copy; <%= new Date().getFullYear() %> YatraTrack | All Rights Reserved 🚀
    </footer>

    <!-- Scripts -->
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.socket.io/4.8.1/socket.io.min.js"
      crossorigin="anonymous"
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/script.js"></script>
  </body>
</html>
